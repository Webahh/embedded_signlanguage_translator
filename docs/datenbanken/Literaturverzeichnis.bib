@article{a.g.TuningHyperparameterADAM2026,
  title = {Tuning the Hyperparameter in {{ADAM}} Optimizer},
  author = {A. G., Vigneshwara Raj. and Murugesan, Punniyamoorthy and M, Nanmaran},
  year = 2026,
  month = apr,
  journal = {Applied Intelligence},
  volume = {56},
  number = {5},
  pages = {185},
  issn = {1573-7497},
  doi = {10.1007/s10489-026-07177-2},
  urldate = {2026-07-24},
  abstract = {The Adam (Adaptive Moment Estimation) algorithm is widely used in deep learning for its adaptive learning rate and momentum-based gradient updating capabilities. Despite its effectiveness, the original Adam algorithm depends on fixed hyperparameters which limits its flexibility, adaptability and performance. This study addresses these limitations by introducing two refined variants of the Adam algorithm---Algorithm-1 and Algorithm-2 which enhances its adaptability by dynamically tuning the key hyperparameters. Algorithm 1 performs iterative adjustments to the hyperparameters {$\alpha$}1, {$\alpha$}2 (decay factors) and learning rate {$\eta$} allowing the algorithm to explore their optimal values for a variety of objective functions. Algorithm 2 further fine tunes this approach by focusing on refining the learning rate {$\eta$} within the identified optimal ranges for {$\alpha$}1 and {$\alpha$}2 obtained from Algorithm-1. These modified algorithms are evaluated on a set of 32 benchmark objective functions and the results obtained evidently shows improvements in the accuracy, time reduction and convergence rate over the standard Adam algorithm. The results infer that adaptive hyperparameter tuning enhances Adam's optimization effectiveness which can be applied in machine learning and deep learning applications to solve complex problems.},
  langid = {english},
  keywords = {ADAM algorithm,Hyperparameters,Optimization techniques},
  file = {/home/webus/Zotero/storage/W8SNDAWL/A. G. et al. - 2026 - Tuning the hyperparameter in ADAM optimizer.pdf}
}

