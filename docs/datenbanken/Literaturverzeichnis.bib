@inproceedings{passoldDynamicWeighingUsing2025,
  title = {Dynamic {{Weighing Using MLP Neural Network Implemented}} on {{ARM Board Equipped}} with {{NPU}}},
  booktitle = {2025 {{IEEE CHILEAN Conference}} on {{Electrical}}, {{Electronics Engineering}}, {{Information}} and {{Communication Technologies}} ({{CHILECON}})},
  author = {Passold, Fernando and {da Silva}, Davi Schena},
  year = 2025,
  month = oct,
  pages = {1--6},
  issn = {2832-1537},
  doi = {10.1109/CHILECON66915.2025.11476510},
  urldate = {2026-05-04},
  abstract = {This project proposes the use of Artificial Neural Networks (ANNs) to filter noise caused by structural vibrations present in dynamic weighing systems, where it is desirable to weigh goods inside moving vehicles without requiring stops, as occurs in static weighing systems. The study highlights the challenges of dynamic force measurement, where external vibrations introduce noise into load cell readings, reducing accuracy. Traditional model-based compensation methods require extensive expertise in mechanics and system dynamics. In contrast, the proposed ANN-based approach learns the relationship between mass and vibration data directly from real-world measurements, eliminating the need for complex mathematical modeling. Key components include a data acquisition system with a 16bit ADC, anti-aliasing filters, and a battery-powered design for portability. An IMU sensor is selected considering bandwidth requirements (50 Hz for structural vibrations), while the load cell is chosen for high accuracy (Class C with \textbackslash mathbf5, 0 0 0 divisions). The acquisition system will be controlled by a microcontroller board based on a 32-bit ARM microcontroller equipped with a neural network processor (NPU), present on the STM32N6570DK Discovery Kit obtained from STMicroelectronics. The project comprises three main phases: data acquisition, ANN training, and embedded implementation (deployment). The results will be evaluated based on the effectiveness of noise reduction, measurement accuracy, and energy efficiency. This solution has potential applications in agriculture and industry, where mobile weighing systems are susceptible to vibrations from uneven surfaces or machinery.},
  keywords = {Aerospace and electronic systems,artificial neural networks,Circuits,Circuits and systems,dynamic weighing,edge AI,embedded systems,Filtering,Filters,Kalman filters,load cells,Low-pass filters,Microcontrollers,Oscillators,Sensor systems,vibration compensation},
}

